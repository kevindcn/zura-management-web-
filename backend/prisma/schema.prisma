generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  avatarUrl    String?
  passwordHash String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  projectsLed     Project[]       @relation("ProjectLead")
  projectMembers  ProjectMember[]
  assignedIssues  Issue[]         @relation("Assignee")
  reportedIssues  Issue[]         @relation("Reporter")
  comments        Comment[]
  activities      Activity[]
  notificationsReceived   Notification[]  @relation("UserNotifications")
  notificationsTriggered  Notification[]  @relation("NotificationActor")
  savedViews              SavedView[]
  watchedIssues           IssueWatcher[]
}

model Project {
  id           String          @id @default(cuid())
  key          String          @unique
  name         String
  description  String?
  iconUrl      String?
  leadId       String
  lead         User            @relation("ProjectLead", fields: [leadId], references: [id])
  issueCounter Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  members      ProjectMember[]
  statuses     Status[]
  issues       Issue[]
  sprints      Sprint[]
  labels       Label[]
  notifications Notification[]
  savedViews   SavedView[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("MEMBER") // ADMIN, MEMBER, VIEWER
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Status {
  id        String   @id @default(cuid())
  name      String
  category  String   @default("TO_DO") // TO_DO, IN_PROGRESS, DONE
  position  Float    @default(0)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    Issue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, position])
}

model Issue {
  id          String      @id @default(cuid())
  key         String      @unique // e.g. PROJ-1
  number      Int
  type        String      @default("TASK") // EPIC, STORY, TASK, BUG, SUBTASK
  title       String
  description String?
  priority    String      @default("MEDIUM") // LOWEST, LOW, MEDIUM, HIGH, HIGHEST
  storyPoints Int?
  startDate   DateTime?
  dueDate     DateTime?
  position    Float       @default(65535)

  statusId    String
  status      Status      @relation(fields: [statusId], references: [id], onDelete: Restrict)

  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId  String?
  assignee    User?       @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  reporterId  String
  reporter    User        @relation("Reporter", fields: [reporterId], references: [id], onDelete: Restrict)

  sprintId    String?
  sprint      Sprint?     @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  parentId    String?
  parent      Issue?      @relation("IssueHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Issue[]     @relation("IssueHierarchy")

  labels      Label[]     @relation("IssueLabels")
  comments    Comment[]
  activities  Activity[]
  watchers    IssueWatcher[]
  issueEvents   IssueEvent[]
  sprintResults SprintIssueResult[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([projectId, statusId, position])
  @@index([key])
}

model Sprint {
  id        String    @id @default(cuid())
  name      String
  goal      String?
  state     String    @default("FUTURE") // FUTURE, ACTIVE, CLOSED
  startDate DateTime?
  endDate   DateTime?
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    Issue[]

  startedAt       DateTime?
  closedAt        DateTime?
  committedPoints Int?      @default(0)
  committedIssues Int?      @default(0)
  completedPoints Int?      @default(0)
  completedIssues Int?      @default(0)
  retroNotes      Json?

  issueEvents         IssueEvent[]
  issueResults        SprintIssueResult[]
  targetIssueResults  SprintIssueResult[] @relation("TargetSprintResult")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model IssueEvent {
  id               String   @id @default(cuid())
  issueId          String
  issue            Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  sprintId         String?
  sprint           Sprint?  @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  eventType        String   // ADDED_TO_SPRINT, REMOVED_FROM_SPRINT, POINTS_CHANGED, STATUS_CHANGED
  points           Int?
  previousPoints   Int?
  category         String?  // TO_DO, IN_PROGRESS, DONE
  previousCategory String?
  createdAt        DateTime @default(now())

  @@index([issueId, createdAt])
  @@index([sprintId, createdAt])
}

model SprintIssueResult {
  id             String   @id @default(cuid())
  sprintId       String
  sprint         Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  issueId        String
  issue          Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  pointsAtClose  Int?     @default(0)
  outcome        String   // COMPLETED, CARRIED_OVER, RETURNED_TO_BACKLOG
  targetSprintId String?
  targetSprint   Sprint?  @relation("TargetSprintResult", fields: [targetSprintId], references: [id], onDelete: SetNull)
  addedMidSprint Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@unique([sprintId, issueId])
  @@index([sprintId])
  @@index([issueId])
}

model Label {
  id        String   @id @default(cuid())
  name      String
  color     String?  @default("#0052CC")
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    Issue[]  @relation("IssueLabels")

  createdAt DateTime @default(now())

  @@unique([projectId, name])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Activity {
  id        String   @id @default(cuid())
  action    String   // CREATED, STATUS_CHANGED, ASSIGNEE_CHANGED, COMMENTED, UPDATED
  field     String?
  oldValue  String?
  newValue  String?
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  type      String   // ASSIGNED, COMMENT, STATUS_CHANGED, SPRINT
  title     String?
  message   String
  issueKey  String?
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
}

model SavedView {
  id        String   @id @default(cuid())
  name      String
  query     String?
  type      String?
  priority  String?
  statusId  String?
  assignee  String?
  isShared  Boolean  @default(false)

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, userId])
}

model IssueWatcher {
  id        String   @id @default(cuid())
  issueId   String
  userId    String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([issueId, userId])
  @@index([issueId])
  @@index([userId])
}
